# Per-environment PUBLIC build config for the web app (committed).
# NEXT_PUBLIC_* are inlined into the bundle at BUILD time on the CI runner.
NEXT_PUBLIC_BACKEND_URL=https://mm.androforces.com

# Public website origin baked into the smart QR (phones must reach this).
# Never use localhost or 0.0.0.0 here.
NEXT_PUBLIC_SITE_URL=https://beta.miami-market.com

NEXT_PUBLIC_ANDROID_URL=https://play.google.com/store/apps/details?id=com.miamimarket.app
# Replace with the real App Store URL once published.
NEXT_PUBLIC_IOS_URL=https://apps.apple.com/app/miami-market/id0000000000
